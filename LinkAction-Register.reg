Windows Registry Editor Version 5.00

[HKEY_LOCAL_MACHINE\SOFTWARE\Clients\StartMenuInternet\LinkAction]
@="LinkAction"

[HKEY_LOCAL_MACHINE\SOFTWARE\Clients\StartMenuInternet\LinkAction\shell\open\command]
@="\"C:\\Program Files\\LinkAction\\LinkAction.exe\" \"%1\""

[HKEY_LOCAL_MACHINE\SOFTWARE\Clients\StartMenuInternet\LinkAction\Capabilities]
"ApplicationName"="LinkAction"
"ApplicationDescription"="LinkAction security prompt for protected links"

[HKEY_LOCAL_MACHINE\SOFTWARE\Clients\StartMenuInternet\LinkAction\Capabilities\URLAssociations]
"http"="LinkActionURL"
"https"="LinkActionURL"

[HKEY_CLASSES_ROOT\LinkActionURL]
@="LinkAction URL"
"URL Protocol"=""

[HKEY_CLASSES_ROOT\LinkActionURL\shell\open\command]
@="\"C:\\Program Files\\LinkAction\\LinkAction.exe\" \"%1\""

[HKEY_LOCAL_MACHINE\SOFTWARE\RegisteredApplications]
"LinkAction"="SOFTWARE\\Clients\\StartMenuInternet\\LinkAction\\Capabilities"
