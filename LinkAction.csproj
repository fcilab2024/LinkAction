<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>true</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LinkAction</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);Core/**;Tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Logo.png" LogicalName="LinkAction.logo.png" />
    <ProjectReference Include="Core\LinkAction.Core.csproj" />
  </ItemGroup>
</Project>
